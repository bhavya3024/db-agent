# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=db-agent

# Connection Store (MongoDB that stores user database connections)
# This is the same MongoDB used by the NextJS UI
CONNECTION_STORE_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbagent?retryWrites=true&w=majority
CONNECTION_STORE_DB_NAME=db-agent

# 1Password service account used to resolve database credentials
OP_SERVICE_ACCOUNT_TOKEN=your_1password_service_account_token_here
OP_VAULT_ID=your_1password_vault_id_here

# PostgreSQL (used by LangGraph for storing checkpoints/threads)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=langgraph
