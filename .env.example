# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=db-agent

# Connection Store (MongoDB that stores user database connections)
# This is the same MongoDB used by the NextJS UI
CONNECTION_STORE_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbagent?retryWrites=true&w=majority
CONNECTION_STORE_DB_NAME=db-agent
