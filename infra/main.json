{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "3782661214201982665"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "metadata": {
        "description": "Name of the environment"
      }
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Primary location for all resources"
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "[format('rg-{0}', parameters('environmentName'))]",
      "metadata": {
        "description": "Name of the resource group"
      }
    },
    "openAiApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "OpenAI API Key"
      }
    },
    "langChainApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "LangChain API Key"
      }
    },
    "langChainProject": {
      "type": "string",
      "defaultValue": "db-agent",
      "metadata": {
        "description": "LangChain Project Name"
      }
    },
    "connectionStoreMongoDbUri": {
      "type": "securestring",
      "metadata": {
        "description": "Connection Store MongoDB URI (shared with NextJS UI)"
      }
    },
    "connectionStoreDbName": {
      "type": "string",
      "defaultValue": "db-agent",
      "metadata": {
        "description": "Connection Store database name"
      }
    }
  },
  "variables": {
    "resourceToken": "[uniqueString(subscription().id, parameters('location'), parameters('environmentName'))]",
    "tags": {
      "azd-env-name": "[parameters('environmentName')]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "resources-deployment",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "resourceToken": {
            "value": "[variables('resourceToken')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "openAiApiKey": {
            "value": "[parameters('openAiApiKey')]"
          },
          "langChainApiKey": {
            "value": "[parameters('langChainApiKey')]"
          },
          "langChainProject": {
            "value": "[parameters('langChainProject')]"
          },
          "connectionStoreMongoDbUri": {
            "value": "[parameters('connectionStoreMongoDbUri')]"
          },
          "connectionStoreDbName": {
            "value": "[parameters('connectionStoreDbName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.39.26.7824",
              "templateHash": "12875913175946037545"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Location for all resources"
              }
            },
            "environmentName": {
              "type": "string",
              "metadata": {
                "description": "Name of the environment - passed for consistency"
              }
            },
            "resourceToken": {
              "type": "string",
              "metadata": {
                "description": "Resource token for unique naming"
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags for all resources"
              }
            },
            "openAiApiKey": {
              "type": "securestring",
              "metadata": {
                "description": "OpenAI API Key"
              }
            },
            "langChainApiKey": {
              "type": "securestring",
              "metadata": {
                "description": "LangChain API Key"
              }
            },
            "langChainProject": {
              "type": "string",
              "metadata": {
                "description": "LangChain Project Name"
              }
            },
            "connectionStoreMongoDbUri": {
              "type": "securestring",
              "metadata": {
                "description": "Connection Store MongoDB URI (shared with NextJS UI)"
              }
            },
            "connectionStoreDbName": {
              "type": "string",
              "metadata": {
                "description": "Connection Store database name"
              }
            }
          },
          "resources": [
