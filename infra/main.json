                "[resourceId('Microsoft.Insights/components', format('azai{0}', parameters('resourceToken')))]",
                "[resourceId('Microsoft.App/managedEnvironments', format('azenv{0}', parameters('resourceToken')))]",
                "[resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', parameters('resourceToken')))]",
                "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', format('azkv{0}', parameters('resourceToken'))), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', format('azkv{0}', parameters('resourceToken'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azid{0}', parameters('resourceToken'))), 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7'))]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azid{0}', parameters('resourceToken')))]"
              ]
            }
          ],
          "outputs": {
            "containerRegistryEndpoint": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', format('azacr{0}', parameters('resourceToken'))), '2023-11-01-preview').loginServer]"
            },
            "containerRegistryName": {
              "type": "string",
              "value": "[format('azacr{0}', parameters('resourceToken'))]"
            },
            "keyVaultName": {
              "type": "string",
              "value": "[format('azkv{0}', parameters('resourceToken'))]"
            },
            "containerAppUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('azca{0}', parameters('resourceToken'))), '2024-03-01').configuration.ingress.fqdn)]"
            },
            "managedIdentityId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azid{0}', parameters('resourceToken')))]"
            },
            "managedIdentityClientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('azid{0}', parameters('resourceToken'))), '2023-01-31').clientId]"
            }
          }
