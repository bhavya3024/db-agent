{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceGroupName": {
      "value": "rg-${AZURE_ENV_NAME}"
    },
    "openAiApiKey": {
      "value": "${OPENAI_API_KEY}"
    },
    "langChainApiKey": {
      "value": "${LANGCHAIN_API_KEY}"
    },
    "langChainProject": {
      "value": "${LANGCHAIN_PROJECT=db-agent}"
    },
    "postgresUser": {
      "value": "${POSTGRES_USER=postgres}"
    },
    "postgresPassword": {
      "value": "${POSTGRES_PASSWORD}"
    },
    "postgresHost": {
      "value": "${POSTGRES_HOST}"
    },
    "postgresPort": {
      "value": "${POSTGRES_PORT=5432}"
    },
    "postgresDb": {
      "value": "${POSTGRES_DB}"
    },
    "postgresSchema": {
      "value": "${POSTGRES_SCHEMA=public}"
    },
    "mongoDbHost": {
      "value": "${MONGODB_HOST}"
    },
    "mongoDbPort": {
      "value": "${MONGODB_PORT=27017}"
    },
    "mongoDbUsername": {
      "value": "${MONGODB_USERNAME}"
    },
    "mongoDbPassword": {
      "value": "${MONGODB_PASSWORD}"
    },
    "mongoDbDatabase": {
      "value": "${MONGODB_DATABASE}"
    }
  }
}
